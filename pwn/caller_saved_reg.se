.intel_syntax noprefix
.global solve

solve:
    # 1. Save all required live caller-saved registers onto the stack
    push rsi     # Save flag_function pointer
    push rax     # Save live values required by the harness
    push rcx
    push rdx
    push r8
    push r9
    push r10
    push r11

    # 2. Call the clobber_function (passed in rdi)
    call rdi

    # 3. Restore all live caller-saved registers from the stack (in reverse order)
    pop r11
    pop r10
    pop r9
    pop r8
    pop rdx
    pop rcx
    pop rax
    pop rsi      # Restore flag_function pointer into rsi

    # 4. Safely call flag_function (now restored in rsi)
    call rsi

    ret
